<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.ros.org/options/package_format3.xsd"?>
<package format="3">
   <name>lab2_pkg</name>
   <version>0.0.1</version>
   <description>Lab 2 Package for ROS 2 Communication Interfaces and QoS</description>
   <maintainer email="student@todo.todo">student</maintainer>
   <license>Apache-2.0</license>

   <buildtool_depend>ament_cmake</buildtool_depend>
   <buildtool_depend>rosidl_default_generators</buildtool_depend>

   <depend>rclcpp</depend>
   <depend>rclcpp_action</depend>
   <depend>std_msgs</depend>

   <exec_depend>rosidl_default_runtime</exec_depend>
